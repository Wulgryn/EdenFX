// =============================================================================================
// Szöveg mesh (bitmap atlasz, UTF8)
// =============================================================================================

// --- 1) UTF-8 dekóder (egyszerű, LTR szöveghez elég) ---
static inline bool utf8_next(const char *&s, uint32_t &cp)
{
    const unsigned char *p = (const unsigned char *)s;
    if (!*p)
        return false;
    if (*p < 0x80)
    {
        cp = *p;
        s = (const char *)(p + 1);
        return true;
    }
    if ((*p & 0xE0) == 0xC0 && (p[1] & 0xC0) == 0x80)
    {
        cp = ((p[0] & 0x1F) << 6) | (p[1] & 0x3F);
        s = (const char *)(p + 2);
        return true;
    }
    if ((*p & 0xF0) == 0xE0 && (p[1] & 0xC0) == 0x80 && (p[2] & 0xC0) == 0x80)
    {
        cp = ((p[0] & 0x0F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F);
        s = (const char *)(p + 3);
        return true;
    }
    if ((*p & 0xF8) == 0xF0 && (p[1] & 0xC0) == 0x80 && (p[2] & 0xC0) == 0x80 && (p[3] & 0xC0) == 0x80)
    {
        cp = ((p[0] & 0x07) << 18) | ((p[1] & 0x3F) << 12) | ((p[2] & 0x3F) << 6) | (p[3] & 0x3F);
        s = (const char *)(p + 4);
        return true;
    }
    return false; // hibás szekvencia
}

// --- 2) Tartomány-kereső a betűatlaszhoz ---
// Elvárás: FontAtlas::ranges = { {32,95,0}, {160,96,95}, {256,128,191}, ... }
// és FontAtlas::chars egy összefűzött tömb (stbtt_packedchar) ezekhez az offsetekhez.

static inline int findRangeIndex(const std::vector<Range> &ranges, uint32_t cp)
{
    for (size_t i = 0; i < ranges.size(); ++i)
    {
        uint32_t first = (uint32_t)ranges[i].first;
        uint32_t last = first + (uint32_t)ranges[i].count; // exclusive
        if (cp >= first && cp < last)
            return (int)i;
    }
    return -1;
}
// ---------- 2) Kis segéd ----------
static inline bool fileExists(const char *p)
{
    std::ifstream f(p, std::ios::binary);
    return (bool)f;
}

static std::vector<int> codepointsFromUTF8(const char *s)
{
    std::unordered_set<int> set;
    const char *p = s;
    uint32_t cp;
    while (utf8_next(p, cp))
    {
        if (cp != '\n')
            set.insert((int)cp);
    }
    // + ASCII 32..126: hogy mindig legyen alap
    for (int c = 32; c <= 126; ++c)
        set.insert(c);
    return std::vector<int>(set.begin(), set.end());
}

static FontAtlas loadFontAtlasByCodepoints(const char *ttfPath, float pixelHeight,
                                           const std::vector<int> &cps,
                                           int atlasW = 1024, int atlasH = 1024,
                                           int overX = 1, int overY = 1, int padding = 1)
{
    FontAtlas fa{};
    fa.w = atlasW;
    fa.h = atlasH;
    fa.pixelHeight = pixelHeight;

    // TTF -> atlaszban tároljuk
    if (!ttfPath || !fileExists(ttfPath))
    {
        std::cerr << "[ERR] Nincs TTF: " << (ttfPath ? ttfPath : "<null>") << "\n";
        return fa;
    }
    std::ifstream ifs(ttfPath, std::ios::binary);
    fa.ttfBytes.assign(std::istreambuf_iterator<char>(ifs), {});
    if (fa.ttfBytes.empty())
    {
        std::cerr << "[ERR] Üres TTF\n";
        return fa;
    }

    // chardata mérete = cps.size()
    fa.codepoints = cps;
    fa.chars.resize(fa.codepoints.size());
    fa.cpToIdx.clear();
    for (size_t i = 0; i < fa.codepoints.size(); ++i)
        fa.cpToIdx[(uint32_t)fa.codepoints[i]] = (int)i;

    // pack (több próbálkozás: 1024 -> 2048, oversampling 1x/2x)
    GLint maxTex = 0;
    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTex);
    int sizes[] = {std::min(atlasW, maxTex > 0 ? maxTex : atlasW), std::min(2048, maxTex > 0 ? maxTex : 2048)};
    int ov[][2] = {{overX, overY}, {2, 2}};

    std::vector<unsigned char> pixels;
    bool ok = false;

    for (int si = 0; si < 2 && !ok; ++si)
    {
        fa.w = fa.h = sizes[si];
        pixels.assign(fa.w * fa.h, 0);

        stbtt_pack_context pc;
        if (!stbtt_PackBegin(&pc, pixels.data(), fa.w, fa.h, 0, padding, nullptr))
            continue;
        stbtt_PackSetOversampling(&pc, ov[si][0], ov[si][1]);

        stbtt_pack_range pr{};
        pr.first_unicode_codepoint_in_range = 0; // kötelező 0, ha listát adunk
        pr.array_of_unicode_codepoints = (int *)fa.codepoints.data();
        pr.num_chars = (int)fa.codepoints.size();
        pr.chardata_for_range = fa.chars.data();
        pr.font_size = pixelHeight;

        if (stbtt_PackFontRanges(&pc, fa.ttfBytes.data(), 0, &pr, 1))
            ok = true;
        stbtt_PackEnd(&pc);
    }
    if (!ok)
    {
        std::cerr << "[ERR] PackFontRanges failed (még mindig túl sok karakter vagy túl nagy méret)\n";
        return fa;
    }

    // metrikák
    if (!stbtt_InitFont(&fa.info, fa.ttfBytes.data(),
                        stbtt_GetFontOffsetForIndex(fa.ttfBytes.data(), 0)))
    {
        std::cerr << "[ERR] InitFont failed\n";
        return fa;
    }
    fa.baseScale = stbtt_ScaleForPixelHeight(&fa.info, pixelHeight);
    int a = 0, d = 0, g = 0;
    stbtt_GetFontVMetrics(&fa.info, &a, &d, &g);
    fa.ascent = a * fa.baseScale;
    fa.descent = d * fa.baseScale;
    fa.lineGap = g * fa.baseScale;

    // GL_RED textúra (R->A swizzle)
    glGenTextures(1, &fa.tex);
    glBindTexture(GL_TEXTURE_2D, fa.tex);
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, fa.w, fa.h, 0, GL_RED, GL_UNSIGNED_BYTE, pixels.data());
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    GLint swz[4] = {GL_ONE, GL_ONE, GL_ONE, GL_RED};
    glTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_RGBA, swz);
    glBindTexture(GL_TEXTURE_2D, 0);

    return fa;
}

// --- 3) UTF-8 szöveg építése (kerninggel) ---
// DROP-IN: hívd ezt a régi buildTextMesh helyett.
static void buildTextMeshUTF8(const FontAtlas &fa, const char *textUTF8,
                              float x, float y, float desiredSizePx,
                              std::vector<float> &out)
{
    if (!fa.tex)
        return;
    float scale = desiredSizePx / fa.pixelHeight;
    float penX = x, penY = y + fa.ascent * scale;

    const char *p = textUTF8;
    uint32_t prev = 0;
    bool havePrev = false;
    while (*p)
    {
        uint32_t cp = 0;
        if (!utf8_next(p, cp))
            break;
        if (cp == '\n')
        {
            penX = x;
            penY += (fa.ascent - fa.descent + fa.lineGap) * scale;
            havePrev = false;
            continue;
        }

        auto it = fa.cpToIdx.find(cp);
        if (it == fa.cpToIdx.end())
        { // fallback '?'
            it = fa.cpToIdx.find('?');
            if (it == fa.cpToIdx.end())
                continue;
        }
        int idx = it->second;

        if (havePrev)
        {
            int kern = stbtt_GetCodepointKernAdvance(&fa.info, (int)prev, (int)cp);
            if (kern)
                penX += (kern * fa.baseScale) * scale;
        }

        float tx = penX, ty = penY;
        stbtt_aligned_quad q;
        stbtt_GetPackedQuad(fa.chars.data(), fa.w, fa.h, idx, &tx, &ty, &q, 1);

        float lx0 = (q.x0 - penX) * scale, ly0 = (q.y0 - penY) * scale;
        float lx1 = (q.x1 - penX) * scale, ly1 = (q.y1 - penY) * scale;
        float x0 = penX + lx0, y0 = penY + ly0, x1 = penX + lx1, y1 = penY + ly1;

        pushQuad(out, x0, y0, x1, y1, q.s0, q.t0, q.s1, q.t1);

        const stbtt_packedchar &pc = fa.chars[idx];
        penX += pc.xadvance * scale;
        prev = cp;
        havePrev = true;
    }
}

